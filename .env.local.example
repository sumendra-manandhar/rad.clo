# Copy this file to .env.local and fill it in, then restart the server.

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# Required in production. In `npm run dev` the password defaults to admin123.
ADMIN_PASSWORD=choose-a-strong-password
# Any long random string; signs the admin login cookie.
SESSION_SECRET=replace-with-a-long-random-string

# ── Optional: Supabase ───────────────────────────────────────────────────────
# Leave these empty to store everything in data/ on this server (fine for a
# normal VPS / your own machine). Set them to store designs, orders, prices
# and uploaded images in Supabase instead — needed on serverless hosts like
# Vercel, whose disk is read-only. Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API → service_role key. Server-only: never expose it.
SUPABASE_SERVICE_ROLE_KEY=
